<meta property="og:url" data-react-helmet="true" content="https://imgur.com/gallery/donate-to-food-bank-send-receipt-get-free-ebooks-more-books-available-than-just-mine-lvC7eeT"><meta name="twitter:image" data-react-helmet="true" content="https://i.imgur.com/crZDVMSh.jpg"><link rel="alternate" type="application/json+oembed" href="https://api.imgur.com/oembed.json?url=https://imgur.com/gallery/donate-to-food-bank-send-receipt-get-free-ebooks-more-books-available-than-just-mine-lvC7eeT" title="Donate to a food bank, send your receipt, get free ebooks... More books available than just mine! - Album on Imgur"><link rel="alternate" type="application/xml+oembed" href="https://api.imgur.com/oembed.xml?url=https://imgur.com/gallery/donate-to-food-bank-send-receipt-get-free-ebooks-more-books-available-than-just-mine-lvC7eeT" title="Donate to a food bank, send your receipt, get free ebooks... More books available than just mine! - Album on Imgur"><meta property="article:tag" data-react-helmet="true" content="Books"><meta property="article:tag" data-react-helmet="true" content="writing"><meta property="article:tag" data-react-helmet="true" content="Mildly Interesting"><link rel="canonical" href="https://imgur.com/gallery/lvC7eeT" data-react-helmet="true" ><meta property="og:image:width" data-react-helmet="true" content="600"><meta property="og:image:height" data-react-helmet="true" content="315"><meta property="og:image" data-react-helmet="true" content="https://i.imgur.com/crZDVMS.jpeg?fb"><meta property="og:type" data-react-helmet="true" content="article"><meta name="twitter:card" data-react-helmet="true" content="summary_large_image"><meta name="description" data-react-helmet="true" content="Discover topics like Books, writing, Mildly Interesting, and the magic of the internet at Imgur, a community powered entertainment destination. Lift your spirits with funny jokes, trending memes, entertaining gifs, inspiring stories, viral videos, and so much more from users like the9mm."><meta name="twitter:title" data-react-helmet="true" content="Donate to a food bank, send your receipt, get free ebooks... More books available than just mine!"><meta name="twitter:description" data-react-helmet="true" content="Discover topics like Books, writing, Mildly Interesting, and the magic of the internet at Imgur, a community powered entertainment destination. Lift your spirits with funny jokes, trending memes, entertaining gifs, inspiring stories, viral videos, and so much more from users like the9mm."><meta property="og:title" data-react-helmet="true" content="Donate to a food bank, send your receipt, get free ebooks... More books available than just mine!"><meta property="og:description" data-react-helmet="true" content="Discover topics like Books, writing, Mildly Interesting, and the magic of the internet at Imgur, a community powered entertainment destination. Lift your spirits with funny jokes, trending memes, entertaining gifs, inspiring stories, viral videos, and so much more from users like the9mm."><script>window.postDataJSON="{\"id\":\"lvC7eeT\",\"account_id\":3747021,\"title\":\"Donate to a food bank, send your receipt, get free ebooks... More books available than just mine!\",\"seo_title\":\"donate-to-food-bank-send-receipt-get-free-ebooks-more-books-available-than-just-mine\",\"description\":\"\",\"view_count\":344,\"upvote_count\":35,\"downvote_count\":1,\"point_count\":34,\"image_count\":1,\"comment_count\":5,\"favorite_count\":2,\"virality\":31214.53147891704,\"score\":34.1565,\"in_most_viral\":false,\"is_album\":true,\"is_mature\":false,\"cover_id\":\"crZDVMS\",\"created_at\":\"2025-11-02T01:18:00Z\",\"updated_at\":null,\"url\":\"https://imgur.com/gallery/donate-to-food-bank-send-receipt-get-free-ebooks-more-books-available-than-just-mine-lvC7eeT\",\"privacy\":\"private\",\"vote\":null,\"favorite\":false,\"is_ad\":false,\"ad_type\":0,\"ad_url\":\"\",\"include_album_ads\":false,\"shared_with_community\":true,\"is_pending\":false,\"platform\":\"android\",\"ad_config\":{\"show_ads\":true,\"show_ad_level\":2,\"ad_sense_client_id\":\"pub-3390380027923570\",\"nsfw_score\":0,\"safe_flags\":[\"gallery\",\"in_gallery\",\"album\"],\"high_risk_flags\":[],\"unsafe_flags\":[],\"wall_unsafe_flags\":[]},\"account\":{\"id\":3747021,\"username\":\"the9mm\",\"avatar_url\":\"https://i.imgur.com/t4HJfxV_d.png?maxwidth\u003D290\\u0026fidelity\u003Dgrand\",\"created_at\":\"2013-03-18T23:03:50Z\"},\"cover\":{\"id\":\"crZDVMS\",\"account_id\":3747021,\"mime_type\":\"image/jpeg\",\"type\":\"image\",\"name\":\"\",\"basename\":\"\",\"url\":\"https://i.imgur.com/crZDVMS.jpeg\",\"ext\":\"jpeg\",\"width\":1080,\"height\":1350,\"size\":350084,\"metadata\":{\"title\":\"\",\"description\":\"Hey folks,\\n\\nA band of us indie authors on Bluesky, Mastodon, and beyond are offering ebooks to people who donate to food banks and send in proof of donation. It\\u0026#39;s just a little way we can give a little extra incentive to anyone who is able to donate. I only have a graphic made for my offering currently however.\\n\\nMost states have authors participating, and each author\\u0026#39;s preferred food bank and amount is different... Some you can send ANY food bank receipt in to claim a free book. This spreadsheet shows what you can claim from what authors: https://docs.google.com/spreadsheets/d/1RAGYTZu5MWGbhv-OJROEMi18n8yXZgkpmTE5H305K8M/edit?usp\u003Ddrivesdk\\n\\nIf you\\u0026#39;re an author and want to participate, you can submit here: https://docs.google.com/forms/d/e/1FAIpQLSdeRucR7v2bu_Zx4blg3apJDHTdJsNfFQa7eJQHtyAb_Q_X0w/viewform\",\"is_animated\":false,\"is_looping\":false,\"duration\":0,\"has_sound\":false},\"created_at\":\"2025-11-02T01:18:00Z\",\"updated_at\":null},\"tags\":[{\"tag\":\"books\",\"display\":\"Books\",\"background_id\":\"exM2Rn0\",\"accent\":\"2E6197\",\"is_promoted\":false},{\"tag\":\"writing\",\"display\":\"writing\",\"background_id\":\"UZ42WEx\",\"accent\":\"51535A\",\"is_promoted\":false},{\"tag\":\"mildly_interesting\",\"display\":\"Mildly Interesting\",\"background_id\":\"oAtvuB2\",\"accent\":\"16A943\",\"is_promoted\":false}],\"media\":[{\"id\":\"crZDVMS\",\"account_id\":3747021,\"mime_type\":\"image/jpeg\",\"type\":\"image\",\"name\":\"\",\"basename\":\"\",\"url\":\"https://i.imgur.com/crZDVMS.jpeg\",\"ext\":\"jpeg\",\"width\":1080,\"height\":1350,\"size\":350084,\"metadata\":{\"title\":\"\",\"description\":\"Hey folks,\\n\\nA band of us indie authors on Bluesky, Mastodon, and beyond are offering ebooks to people who donate to food banks and send in proof of donation. It\'s just a little way we can give a little extra incentive to anyone who is able to donate. I only have a graphic made for my offering currently however.\\n\\nMost states have authors participating, and each author\'s preferred food bank and amount is different... Some you can send ANY food bank receipt in to claim a free book. This spreadsheet shows what you can claim from what authors: https://docs.google.com/spreadsheets/d/1RAGYTZu5MWGbhv-OJROEMi18n8yXZgkpmTE5H305K8M/edit?usp\u003Ddrivesdk\\n\\nIf you\'re an author and want to participate, you can submit here: https://docs.google.com/forms/d/e/1FAIpQLSdeRucR7v2bu_Zx4blg3apJDHTdJsNfFQa7eJQHtyAb_Q_X0w/viewform\",\"is_animated\":false,\"is_looping\":false,\"duration\":0,\"has_sound\":false},\"created_at\":\"2025-11-02T01:18:00Z\",\"updated_at\":null}],\"display\":[]}"</script> <link rel="preconnect" href="https://fonts.googleapis.com"> <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> <link href="https://fonts.googleapis.com/css2?family=Comic+Neue:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet"> <script>//!SSR:no </script> <script>-1===["i".concat("mgur.com"),"i".concat("mgur-stg.com"),"localhost"].indexOf(window.location.hostname)&&window.location.replace("https://i".concat("mgur.com"))</script> <script>!function(e,t,a,n){e[n]=e[n]||[],e[n].push({"gtm.start":(new Date).getTime(),event:"gtm.js"});v